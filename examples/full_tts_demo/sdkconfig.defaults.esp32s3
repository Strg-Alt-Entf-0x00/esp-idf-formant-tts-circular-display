# Target configuration for ESP32-S3
CONFIG_IDF_TARGET="esp32s3"

# Flash configuration
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM configuration (Octal PSRAM common on S3)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Performance
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_FREERTOS_HZ=1000

# Display Component
CONFIG_FORMANT_DISPLAY_ENABLE_TTS_VIZ=y
CONFIG_FORMANT_DISPLAY_ENABLE_ALPHABET_RING=y
CONFIG_FORMANT_DISPLAY_USE_PSRAM=y
CONFIG_FORMANT_DISPLAY_WIDTH=240
CONFIG_FORMANT_DISPLAY_HEIGHT=240
CONFIG_FORMANT_DISPLAY_SPECTRUM_BARS=32
CONFIG_FORMANT_DISPLAY_IPA_FONT=y
