# ============================================================================
# ESP32-P4 Hardware Target Configuration
# ============================================================================
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# ============================================================================
# Flash Configuration (32 MB QIO Mode)
# ============================================================================
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# ============================================================================
# PSRAM Configuration (required for TTS + Display)
# ============================================================================
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y

# ============================================================================
# Compiler Optimization
# ============================================================================
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# ============================================================================
# FreeRTOS Configuration
# ============================================================================
CONFIG_FREERTOS_HZ=1000

# ============================================================================
# Display Component Configuration
# ============================================================================
# Enable TTS visualization
CONFIG_FORMANT_DISPLAY_ENABLE_TTS_VIZ=y

# Enable alphabet ring
CONFIG_FORMANT_DISPLAY_ENABLE_ALPHABET_RING=y

# Use PSRAM for sprite buffer (recommended)
CONFIG_FORMANT_DISPLAY_USE_PSRAM=y

# Display resolution (GC9A01 = 240x240)
CONFIG_FORMANT_DISPLAY_WIDTH=240
CONFIG_FORMANT_DISPLAY_HEIGHT=240

# Spectrum analyzer bars
CONFIG_FORMANT_DISPLAY_SPECTRUM_BARS=32

# Enable IPA fonts for proper phonetic display
CONFIG_FORMANT_DISPLAY_IPA_FONT=y
