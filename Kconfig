menu "Formant TTS Circular Display"

    config FORMANT_DISPLAY_WIDTH
        int "Display width in pixels"
        default 240
        help
            Width of the circular display (typically 240px for GC9A01)

    config FORMANT_DISPLAY_HEIGHT
        int "Display height in pixels"
        default 240
        help
            Height of the circular display (typically 240px for GC9A01)

    config FORMANT_DISPLAY_ENABLE_TTS_VIZ
        bool "Enable TTS visualization"
        default y
        help
            Enable phoneme display, spectrum analyzer, and IPA/word tracking.

    config FORMANT_DISPLAY_ENABLE_ALPHABET_RING
        bool "Enable alphabet ring"
        default y
        depends on FORMANT_DISPLAY_ENABLE_TTS_VIZ
        help
            Enable the outer A-Z alphabet ring that highlights during speech.

    config FORMANT_DISPLAY_USE_PSRAM
        bool "Use PSRAM for sprite buffer"
        default y
        help
            Store the display sprite buffer in PSRAM instead of internal RAM.
            Recommended for ESP32-P4 with large PSRAM.

    config FORMANT_DISPLAY_SPECTRUM_BARS
        int "Number of spectrum bars"
        default 32
        range 16 64
        depends on FORMANT_DISPLAY_ENABLE_TTS_VIZ
        help
            Number of radial spectrum bars for audio visualization.

    config FORMANT_DISPLAY_IPA_FONT
        bool "Use IPA-capable Unicode font"
        default y
        help
            Enable UTF-8/IPA font support for proper phonetic symbol rendering.
            Uses Noto Sans font (generated by tools/setup_and_generate_fonts.sh
            or tools/generate_fonts_windows.bat).
            Pre-rendered at native sizes (10pt, 12pt, 16pt, ~75KB total in Flash).
            Disable to save flash memory if only ASCII fallback text is needed.

endmenu
